{
  "$defs": {
    "BenchmarkSummary": {
      "additionalProperties": false,
      "description": "Complete deterministic sample -> dataset -> track -> benchmark view.",
      "properties": {
        "benchmark_id": {
          "const": "dime_bench_v1",
          "default": "dime_bench_v1",
          "title": "Benchmark Id",
          "type": "string"
        },
        "datasets": {
          "items": {
            "$ref": "#/$defs/DatasetResult"
          },
          "title": "Datasets",
          "type": "array"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelBenchmarkResult"
          },
          "title": "Models",
          "type": "array"
        },
        "run_root": {
          "title": "Run Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackResult"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "run_root",
        "source_fingerprint",
        "datasets",
        "tracks",
        "models"
      ],
      "title": "BenchmarkSummary",
      "type": "object"
    },
    "DatasetResult": {
      "additionalProperties": false,
      "description": "Validated result for one model, task, and dataset.",
      "properties": {
        "artifact_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifact Hashes",
          "type": "object"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricEvidence"
          },
          "title": "Metrics",
          "type": "object"
        },
        "model_family": {
          "enum": [
            "autoregressive",
            "diffusion"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "primary_metric": {
          "minLength": 1,
          "title": "Primary Metric",
          "type": "string"
        },
        "primary_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Value"
        },
        "reasoning_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Type"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "track": {
          "minLength": 1,
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "model_id",
        "model_family",
        "dataset_id",
        "task_id",
        "track",
        "primary_metric",
        "primary_value",
        "sample_count",
        "config_hash",
        "metrics",
        "artifact_hashes",
        "source_path"
      ],
      "title": "DatasetResult",
      "type": "object"
    },
    "MetricEvidence": {
      "additionalProperties": false,
      "description": "One aggregate plus the exact samples and file that produced it.",
      "properties": {
        "coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "failure_count": {
          "minimum": 0,
          "title": "Failure Count",
          "type": "integer"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_ids_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sample Ids Hash",
          "type": "string"
        },
        "skipped_count": {
          "minimum": 0,
          "title": "Skipped Count",
          "type": "integer"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_run_id": {
          "minLength": 1,
          "title": "Source Run Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "total_sample_count": {
          "minimum": 0,
          "title": "Total Sample Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "value",
        "sample_count",
        "total_sample_count",
        "coverage",
        "failure_count",
        "skipped_count",
        "sample_ids_hash",
        "source_run_id",
        "source_path",
        "source_sha256"
      ],
      "title": "MetricEvidence",
      "type": "object"
    },
    "ModelBenchmarkResult": {
      "additionalProperties": false,
      "description": "Macro-average of available track scores for one model.",
      "properties": {
        "benchmark_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Benchmark Score"
        },
        "model_family": {
          "enum": [
            "autoregressive",
            "diffusion"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "source_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Run Ids",
          "type": "array"
        },
        "track_scores": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Track Scores",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_family",
        "benchmark_score",
        "track_scores",
        "source_run_ids"
      ],
      "title": "ModelBenchmarkResult",
      "type": "object"
    },
    "TrackResult": {
      "additionalProperties": false,
      "description": "Macro-average of dataset primary metrics for one model and track.",
      "properties": {
        "dataset_count": {
          "minimum": 0,
          "title": "Dataset Count",
          "type": "integer"
        },
        "macro_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Macro Score"
        },
        "model_family": {
          "enum": [
            "autoregressive",
            "diffusion"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Run Ids",
          "type": "array"
        },
        "track": {
          "minLength": 1,
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "track",
        "model_id",
        "model_family",
        "macro_score",
        "dataset_count",
        "source_run_ids"
      ],
      "title": "TrackResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One immutable v1 benchmark summary accepted by the leaderboard.",
  "properties": {
    "benchmark_id": {
      "const": "dime_bench_v1",
      "default": "dime_bench_v1",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Benchmark Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Submission Id",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/BenchmarkSummary"
    },
    "summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Summary Sha256",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "summary_sha256",
    "summary"
  ],
  "title": "ResultSubmission",
  "type": "object"
}
